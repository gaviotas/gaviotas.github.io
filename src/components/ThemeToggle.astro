<button id="theme-toggle" class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode" title="Toggle light / dark mode" hidden>
  <span class="theme-thumb" aria-hidden="true"></span>
  <svg class="theme-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5.5"/>
    <path d="M12 2v1.5m0 17V22M2 12h1.5m17 0H22M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1"/>
    <g fill="currentColor" stroke="none"><circle cx="10" cy="11" r=".65"/><circle cx="14" cy="11" r=".65"/></g>
    <path d="M10 13.5q2 2 4 0" stroke-width="1.2"/>
  </svg>
  <svg class="theme-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z"/>
    <path d="M6.5 12.5q1.3 1.5 2.6 0m-.6 4q1.2 1 2.4 0" stroke-width="1.2"/>
  </svg>
</button>

<style>
  .theme-toggle { position: relative; display: flex; align-items: center; justify-content: space-around; flex-shrink: 0; width: 76px; height: 44px; border-radius: 24px; border: 1px solid var(--border-color); background: var(--surface-color); color: var(--muted-color); cursor: pointer; }
  .theme-toggle[hidden] { display: none; }
  .theme-thumb { position: absolute; top: 5px; left: 5px; width: 32px; height: 32px; border-radius: 50%; background: var(--accent-color); box-shadow: 0 2px 4px rgb(0 0 0 / .16); transition: transform .42s cubic-bezier(.22, 1.12, .36, 1), background-color .25s ease-out; }
  .theme-toggle svg { position: absolute; top: 12px; z-index: 1; pointer-events: none; transition: color .25s ease-out, opacity .25s ease-out, transform .42s cubic-bezier(.16, 1, .3, 1); }
  .theme-sun { left: 12px; color: var(--accent-ink); opacity: 1; transform: rotate(0deg) scale(1); }
  .theme-moon { left: 44px; color: var(--muted-color); opacity: .8; transform: rotate(12deg) scale(1); }
  :global([data-theme='profile-dark']) .theme-thumb { transform: translateX(32px); }
  :global([data-theme='profile-dark']) .theme-sun { color: var(--heading-color); opacity: 1; stroke-width: 1.8; transform: rotate(-12deg) scale(1); }
  :global([data-theme='profile-dark']) .theme-moon { color: var(--accent-ink); opacity: 1; transform: rotate(0deg) scale(1); }
  @media (prefers-reduced-motion: reduce) { .theme-thumb, .theme-toggle svg { transition: none; } }
  .theme-toggle:hover { border-color: var(--accent-underline-color); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent-color); outline-offset: 4px; }
</style>

<script>
  const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
  let preference: string | null = null;
  try { preference = localStorage.getItem('profile-theme'); } catch {}
  function apply() {
    const dark = preference === 'dark';
    document.documentElement.dataset.theme = dark ? 'profile-dark' : 'lofi';
    toggle?.setAttribute('aria-checked', String(dark));
  }
  toggle?.addEventListener('click', () => {
    preference = document.documentElement.dataset.theme === 'profile-dark' ? 'light' : 'dark';
    try { localStorage.setItem('profile-theme', preference); } catch {}
    apply();
  });
  window.addEventListener('storage', event => {
    if (event.key === 'profile-theme' || event.key === null) {
      preference = event.newValue;
      apply();
    }
  });
  apply();
  if (toggle) toggle.hidden = false;
</script>
